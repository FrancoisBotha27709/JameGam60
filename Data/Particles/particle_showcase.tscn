[sub_resource type="GDScript" id="GDScript_replay"]
script/source = "extends Node2D

func _ready() -> void:
	var t := Timer.new()
	t.wait_time = 2.0
	t.autostart = true
	t.timeout.connect(_replay)
	add_child(t)

func _replay() -> void:
	for c in get_children():
		if c is FXEmitter and c.one_shot:
			c.restart()
"

